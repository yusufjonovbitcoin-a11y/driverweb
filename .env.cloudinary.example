SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Required for expiring private delivery URLs. This must be the hexadecimal
# token-auth key issued by Cloudinary Support, not the API secret.
CLOUDINARY_AUTH_TOKEN_KEY=your-hex-token-auth-key
# Keep source objects until migration is verified. Set true only for final cleanup.
CLOUDINARY_DELETE_SOURCE=false
