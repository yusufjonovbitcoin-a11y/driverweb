SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional Cloudinary Advanced feature. This must be the hexadecimal token
# encryption key issued by Cloudinary Support, not the API secret.
CLOUDINARY_AUTH_TOKEN_KEY=
# Keep source objects until migration is verified. Set true only for final cleanup.
CLOUDINARY_DELETE_SOURCE=false
