# Gmail address and App Password are normally configured in Profile > Integrations.
# Keep these only as a legacy fallback before the Vault migration is deployed.
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=
GMAIL_COMPANY_ID=your-supabase-company-uuid
GMAIL_WORKER_TOKEN=replace-with-a-long-random-token
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GMAIL_MAX_MESSAGES=25
# Enable after the cloudinary-media Edge Function has its Cloudinary secrets.
CLOUDINARY_REQUIRED=true
